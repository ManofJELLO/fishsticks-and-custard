	makedepends = cmake
	makedepends = vulkan-headers
	makedepends = shaderc
	depends = gcc-libs
	depends = glibc
	depends = glib2
	depends = cairo
	depends = pango
	depends = gtk4
	depends = gtk4-layer-shell
	depends = pipewire
	depends = alsa-lib
	depends = vulkan-icd-loader
	depends = espeak-ng
	depends = pcaudiolib
	depends = libsonic
	optdepends = hyprland: the compositor this is designed for (any wlroots-style layer-shell compositor works)
