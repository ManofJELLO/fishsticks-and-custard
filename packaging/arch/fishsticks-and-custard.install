post_install() {
  cat <<'MSG'
==> Fishsticks & Custard installed. To finish setting up (as your user):
    1. Install and sign in to an agent: the Claude Code CLI (`claude`) by default,
       or Codex / Antigravity (see "Choosing an agent" in the README).
    2. Download the speech models (~900 MB, with a voice for your desktop's
       language):                                 fsc fetch-models
       and check them:                            fscd --self-test
    3. Add the Hyprland lines from /usr/share/fishsticks-and-custard/hyprland/fsc.lua
       to your config, including `hl.exec_cmd("fscd")` in your startup block.
    4. Optional settings: /usr/share/fishsticks-and-custard/config.example.toml
       -> ~/.config/fsc/config.toml
MSG
}

post_upgrade() {
  echo "==> Fishsticks & Custard updated. Restart it to use the new version: fsc quit; fscd &"
  if [ "$(vercmp "$2" 0.10.0)" -lt 0 ]; then
    echo "    0.10.0 hears the wake phrase with a small, fast model (~250 MB). Get it with:"
    echo "        fsc fetch-models"
    echo "    Until then the wake phrase is heard by the full model, more slowly."
  else
    echo "    New models may be needed after some updates: fsc fetch-models"
  fi
}
